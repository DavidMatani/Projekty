# DO NOT commit actual credentials! EnvironmentFile syntax for systemd.
MONITOR_USER=admin
MONITOR_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
FLASK_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MONITOR_DB=/var/lib/raspberry-monitor/metrics.sqlite3
MONITOR_DISKS=/,/srv/km-cloud,/mnt/sd-backup
SAMPLE_INTERVAL=20
ALERT_CPU=90
ALERT_RAM=90
ALERT_TEMP_C=78
ALERT_DISK=90
# Enable when served only via HTTPS (recommended).
COOKIE_SECURE=1
TRUST_PROXY=0
